<Window x:Class="NotePad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotePad"
        mc:Ignorable="d"
        Title="NotePad" Height="450" Width="800" Icon="/Assets/app1_icon.ico">
    <Grid Background="#FF1A1A1A">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Border Background="#272727" BorderThickness="1" CornerRadius="8" Margin="6">
            <TextBox x:Name="SearchBar" TextChanged="SearchBar_TextChanged" VerticalAlignment="Center" Padding="4" Margin="3" SelectionBrush="#272727" Background="#272727" Foreground="White" BorderBrush="#272727" BorderThickness="0"></TextBox>
        </Border>
        <Border Grid.Row="1" CornerRadius="8" BorderBrush="#272727" BorderThickness="6" Margin="7">
            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="NoteList_SelectionChanged" x:Name="NoteList" Grid.Row="1" Background="#272727" Foreground="White" FontSize="12" FontWeight="Bold"  BorderBrush="#272727"></ListBox>
        </Border>
        <Button x:Name="ShowCreateContent" Click="ShowCreateContent_Click" HorizontalAlignment="Left" Height="30" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Width="30" FontWeight="Bold" Foreground="White" BorderBrush="{x:Null}" Background="#FF47A346" >
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontWeight="Light" Text="&#xE160;" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,1,1,1" x:Name="saveicon"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button x:Name="DeleteNote" Click="DeleteNote_Click" HorizontalAlignment="Left" Height="30" Grid.Row="0" Grid.Column="1" Margin="40,0,0,0" VerticalAlignment="Center" Width="30" FontWeight="Bold" Foreground="White" BorderBrush="{x:Null}" Background="#FFA34646" >
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE107;" FontSize="15" Foreground="White" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="saveicon"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>


        <Button x:Name="SaveNote" HorizontalAlignment="Right" Click="SaveNote_Click" Height="30" Grid.Row="0" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" Width="30" FontWeight="Bold" Foreground="White" BorderBrush="{x:Null}" Background="#4786c8">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontWeight="Light" Text="&#xE105;" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="saveicon"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border Grid.Row="1" Grid.Column="1"
        BorderBrush="#272727"
        BorderThickness="6"
        Margin="5"
        CornerRadius="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>

                <!-- RICHTEXTBOX -->
                <RichTextBox x:Name="TextArea1"
                     Grid.Row="0"
                     Background="#272727"
                     Foreground="White"
                     BorderThickness="0"
                     FontSize="14"
                     Block.LineHeight="1"
                     TextChanged="TextArea1_TextChanged"/>

                <!-- STATUS BAR -->
                <StatusBar Grid.Row="1"
                   Background="#272727"
                   BorderThickness="0">

                    <!-- SOL -->
                    <StatusBarItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatusIcon"
                               Text="●"
                               Margin="0,0,6,0"
                               Foreground="Green"/>
                            <TextBlock x:Name="StatusText"
                               Text="Hazır"
                               Foreground="#BFBFBF"/>
                        </StackPanel>
                    </StatusBarItem>

                    <!-- ORTA -->
                    <StatusBarItem HorizontalAlignment="Center">
                        <TextBlock x:Name="FileInfoText"
                           Text="Not seçilmedi"
                           Foreground="#888"/>
                    </StatusBarItem>

                    <!-- SAĞ -->
                    <StatusBarItem HorizontalAlignment="Right">
                        <TextBlock x:Name="AutoSaveText"
                           Text="Autosave açık"
                           Foreground="#777"/>
                    </StatusBarItem>

                </StatusBar>

            </Grid>
        </Border>


        <Border x:Name="EntryNotePadNameBorder" Visibility="Hidden" Background="#272727" BorderThickness="1" CornerRadius="8" Grid.Row="0" Grid.Column="1" Height="40" Width="170" HorizontalAlignment="Left" Margin="96,6,6,6">
            <TextBox x:Name="NotePadNameCreate" Margin="3" SelectionBrush="#272727" Background="#272727" Foreground="White" BorderBrush="#272727" BorderThickness="0"></TextBox>
        </Border>
        <Button Visibility="Hidden" x:Name="CreateButton" Content="Create" HorizontalAlignment="Left" Height="40" Grid.Row="0" Grid.Column="1" Margin="270,0,0,0" VerticalAlignment="Center" Width="90" FontWeight="Bold" Foreground="White" BorderBrush="{x:Null}" Background="#FF47A346" Click="CreateButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                        
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
    
</Window>